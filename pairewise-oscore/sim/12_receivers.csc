    <plugin_config>
      <script>TIMEOUT(1200000000);

while (true) {
    YIELD();

    log.log(time + "\tID:" + id + "\t" + msg + "\n");

    if (msg.indexOf("PAIRWISE_OSCORE_END") &gt;= 0) {
        log.testOK();
    }
}</script>
      <active>true</active>
    </plugin_config>
